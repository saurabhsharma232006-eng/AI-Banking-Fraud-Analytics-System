# ============================================================
# AI-Powered Banking & Fraud Transaction Analytics System
# Environment Configuration
# ============================================================

# --- LLM Provider (xAI Grok) ---
XAI_API_KEY=your_xai_api_key_here
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-beta

# --- Fallback: OpenAI (optional) ---
OPENAI_API_KEY=your_openai_api_key_here

# --- Database ---
DATABASE_URL=sqlite:///./data/transactions.db
DATABASE_ECHO=false

# --- API Settings ---
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
API_WORKERS=1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:5500"]

# --- ML Settings ---
MODEL_PATH=models/
FRAUD_THRESHOLD=0.5
BATCH_SIZE=1000

# --- Data Generation ---
NUM_TRANSACTIONS=50000
FRAUD_RATIO=0.025
RANDOM_SEED=42

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
